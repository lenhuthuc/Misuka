# Copy to .env and adjust. Every value here has a working default (see
# brain/config.py) — only uncomment what you need to override.

# ── HTTP server ──────────────────────────────────────────────────────────────
# Port 8010 rather than 8000: Docker Desktop publishes container ports on both
# `0.0.0.0` and `[::]`, so any container holding 8000 also owns `localhost:8000`
# for the whole machine (Windows resolves `localhost` to `::1` first, and
# uvicorn's `0.0.0.0` is IPv4-only). Change both this and LOCAL_API_URL in
# `airi/apps/stage-web/src/pages/index.vue` if you move it.
# API_HOST=0.0.0.0
# API_PORT=8010

# ── Sherpa-ONNX (speech-to-text, Vietnamese-only) ────────────────────────────
# Not shipped in the repo. Download the model with:
#   pip install "huggingface_hub[cli]"
#   huggingface-cli download csukuangfj2/sherpa-onnx-zipformer-vi-30M-int8-2026-02-09 \
#     --local-dir assets/models/sherpa-onnx-zipformer-vi-30M-int8-2026-02-09
# Leaving the four paths below empty resolves them under SHERPA_ONNX_MODEL_DIR
# using that repo's file names (tokens.txt, encoder.int8.onnx, decoder.onnx,
# joiner.int8.onnx). Set them individually only if your files live elsewhere.
# SHERPA_ONNX_MODEL_DIR=
# SHERPA_ONNX_TOKENS=
# SHERPA_ONNX_ENCODER=
# SHERPA_ONNX_DECODER=
# SHERPA_ONNX_JOINER=
SHERPA_ONNX_NUM_THREADS=4

# ── VAD checkpoints (shipped in model/) ──────────────────────────────────────
# TEXT_VAD_CHECKPOINT_PATH=model/best_text_vad.pt
# MULTIMODAL_VAD_CHECKPOINT_PATH=model/best_multimodal_vad.pt

# ── Piper TTS + prosody ──────────────────────────────────────────────────────
# PIPER_MODELS_DIR=
# TTS_DEFAULT_VOICE=fusion_E_ling75_acoustic100
# How far the agent's V/A/D moves tempo, pitch and the Fujisaki F0 contour
# (service/prosody.py). 0.0 renders exactly what Piper would on its own — the
# A/B switch for the whole stage; 1.0 is the tuned default; above ~1.5 the
# granular pitch shifter starts to be audible as such.
# TTS_PROSODY_DEPTH=1.0

# ── LLM (Ollama) ─────────────────────────────────────────────────────────────
# The default model is `mitsuka-ft`, built from the fine-tune in assets/models/LLM:
#   cd assets/models/LLM && ollama create mitsuka-ft -f Modelfile
# Point OLLAMA_MODEL at a stock model (e.g. qwen3:1.7b) only to A/B against the
# base — expect the persona to change, since it lives in the fine-tune's
# Modelfile SYSTEM rather than in any prompt this codebase sends.
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=mitsuka-ft
# Overrides the Modelfile's `PARAMETER temperature`; keep the two in step.
# LLM_TEMPERATURE=0.65
# LLM_MAX_TOKENS=320

# ── Conversation graph and cloud routing ────────────────────────────────────
# Cloud is preferred when both CLOUD_ENABLED and GEMINI_API_KEY are set. A
# missing key is a normal local-only configuration; transient failures fall
# back to Ollama and retry after the cooldown.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite
# CLOUD_ENABLED=true
# CLOUD_TIMEOUT_SECONDS=30.0
# CLOUD_MAX_RETRIES=1
# CLOUD_TRANSIENT_COOLDOWN_SECONDS=60.0
# CLOUD_QUOTA_RESET_TIMEZONE=America/Los_Angeles

# Number of complete exchanges retained before older rows are folded into the
# per-session rolling summary. This is separate from MEMORY_RECENT_LIMIT below,
# which controls the smaller prompt-prefill window.
# GRAPH_HISTORY_TURNS=12
# GRAPH_SUMMARY_MAX_TOKENS=160
# GRAPH_SUMMARY_DEFER_TIMEOUT=90.0
# GRAPH_MAX_REGENERATIONS=1

# Guard limits. Violence is replaced immediately; self-ending text is trimmed;
# repetition, empty output, and excessive length are regenerated once.
# GUARD_MAX_SENTENCES=5
# GUARD_MAX_CHARS=600
# GUARD_PREVIOUS_TURN_SIMILARITY=0.85

# One JSON object per completed graph turn. Disable when metrics should not be
# persisted, or point the path at a different local file.
# TURN_METRICS_ENABLED=true
# TURN_METRICS_PATH=logs/turns.jsonl

# ── Conversation context ─────────────────────────────────────────────────────
# Variable prompt budget: 70% recent chat, at most 30% retrieved memory.
# RAG hits below the cosine threshold are omitted entirely.
# MEMORY_RECENT_CHAR_BUDGET=1600
# RAG_CONTEXT_CHAR_BUDGET=1500
# RAG_MIN_SCORE=0.50
# Enable hidden deliberation only when the strongest RAG/history relevance
# score is below the threshold. Its independent hard token cap follows a
# normalized -log curve from MAX at zero confidence toward MIN at the threshold
# (rounded down); the spoken answer keeps its own cap.
# REASONING_ENABLED=true
# REASONING_ACTIVATION_THRESHOLD=0.50
# REASONING_MODEL=qwen3:1.7b
# REASONING_MIN_TOKENS=64
# REASONING_MAX_TOKENS=192
# REASONING_TOKEN_SCALE=0.45
# 6 messages = approximately 3 recent user/assistant exchanges, checked first.
# MEMORY_RECENT_LIMIT=6
# BM25_REPETITION_THRESHOLD=0.78
# BM25_REPETITION_MIN_TOKENS=5
# BM25_REPETITION_MAX_SENTENCES=2000

# ── Web search (DuckDuckGo, no API key needed) ───────────────────────────────
# Fires for two narrow query classes, never for chit-chat -- see
# brain/nodes/should_search_web.py:
#   live info    weather, news, prices, "nên mua ... nào"
#   knowledge    an open-world question the frozen local weights cannot be
#                trusted on ("tôm biển là con gì"). Questions about the user
#                or about Mitsuka herself stay with RAG and never search.
# WEB_SEARCH_ENABLED=true
# WEB_SEARCH_MAX_RESULTS=3
# WEB_SEARCH_CONTEXT_CHAR_BUDGET=800
# WEB_SEARCH_TIMEOUT_SECONDS=6.0
# WEB_SEARCH_REGION=vn-vi
# Set false to restore the previous behaviour: live info still searches,
# knowledge questions go ungrounded.
# WEB_SEARCH_KNOWLEDGE_ENABLED=true

# ── Vision captioning ─────────────────────────────────────────────────────────
# POST /v1/vision/caption describes an uploaded image with a local VLM
# (moondream2, then Florence-2, then a placeholder) so an attached image can
# reach the text-only chat model as words. Downloads its weights from Hugging
# Face on first use; set false to skip that entirely.
# VISION_CAPTIONING_ENABLED=true

# ── Knowledge-turn decoding ──────────────────────────────────────────────────
# Applied only when a knowledge question actually retrieved something to answer
# from. Colder than chat because the conversational 0.65 is what makes the same
# question sample different "facts" on different turns; longer because the
# fine-tune's 1-3 sentence rule is enough for a tease and not for an answer.
# KNOWLEDGE_TEMPERATURE=0.30
# KNOWLEDGE_MAX_TOKENS=480
